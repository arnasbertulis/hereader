# Allowlist: everything is excluded from the build context by default (the
# leading *), and only what the Dockerfile's COPY steps actually reference is
# re-included below. A file added to server/ later — including .env, which
# carries JWT_SECRET and the database password — stays out of the build
# context without anyone needing to add it here.
*
!.mvn/
!.mvn/**
!mvnw
!pom.xml
!src/
!src/**
