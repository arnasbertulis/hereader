204-168-240-12.sslip.io {
    header {
        Cross-Origin-Opener-Policy same-origin
        Cross-Origin-Embedder-Policy require-corp
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # gstatic.com is load-bearing: the release build fetches CanvasKit's
        # JS and .wasm from Google's CDN rather than the local copy it also
        # ships (docs/adr/0028-content-security-policy.md has the trace
        # through flutter_bootstrap.js's buildConfig that established this).
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://www.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; manifest-src 'self'"
    }

    handle /api/* {
        # Bounds memory on a 4GB VPS shared with Postgres against an
        # authenticated client posting an arbitrarily large sync batch.
        # Limits actual bytes as they stream in, not just a declared
        # Content-Length, so it also catches a chunked request that omits
        # one. Keep this equal to SyncRequestSizeFilter.MAX_PUSH_REQUEST_BYTES
        # (server/src/main/java/lt/hereader/server/sync/SyncRequestSizeFilter.java)
        # — that file has the derivation.
        request_body {
            max_size 16MB
        }
        reverse_proxy app:8080
    }

    handle {
        root * /srv/web

        # try_files {path} /index.html alone answers 200 for every missing
        # path, asset or route alike, because /index.html always exists as
        # the fallback candidate (issue #124). Gate the fallback to paths
        # that look like a client-side route: no file extension. A request
        # for a real but missing asset then reaches file_server unrewritten
        # and gets a genuine 404. Extensions below are what
        # `flutter build web` emits today, plus common static-asset types
        # this bundle doesn't currently use, so a future asset type missing
        # on deploy still 404s instead of silently returning the SPA shell.
        @spa {
            not path *.js *.mjs *.wasm *.map *.json *.png *.jpg *.jpeg *.svg *.ico *.css *.ttf *.otf *.woff *.woff2 *.bin *.symbols *.frag *.last_build_id *.html
            file {
                try_files {path} /index.html
            }
        }
        rewrite @spa {file_match.relative}

        file_server
    }
}