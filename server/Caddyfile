hereader.arnasbertulis.com {
    # Cloudflare proxies this hostname (docs/adr/0039-cloudflare-authenticated-origin-pulls.md).
    # The origin IP is public — it's in this repo's own git history — so a
    # request reaching this site block proves nothing about having gone
    # through Cloudflare unless something checks. client_auth does that:
    # Cloudflare presents a client certificate signed by its own Origin Pull
    # CA on every proxied request, and require_and_verify rejects anything
    # that doesn't carry one. Toggled on in the Cloudflare dashboard under
    # SSL/TLS → Origin Server → Authenticated Origin Pulls; the CA cert
    # itself is public (not a secret) and shared across all Cloudflare
    # accounts, downloaded from
    # https://developers.cloudflare.com/ssl/static/authenticated_origin_pull_ca.pem.
    tls {
        client_auth {
            mode require_and_verify
            trust_pool file {
                pem_file /etc/caddy/cloudflare-origin-pull-ca.pem
            }
        }
    }

    header {
        Cross-Origin-Opener-Policy same-origin
        Cross-Origin-Embedder-Policy require-corp
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # The release build serves CanvasKit's JS and .wasm from its own
        # origin (--no-web-resources-cdn, #160), so script-src and
        # connect-src no longer need Google's gstatic.com CDN host
        # (docs/adr/0028-content-security-policy.md has the trace through
        # flutter_bootstrap.js's buildConfig that first found the dependency).
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; manifest-src 'self'"
    }

    handle /api/* {
        # Bounds memory on a 4GB VPS shared with Postgres against an
        # authenticated client posting an arbitrarily large sync batch.
        # Limits actual bytes as they stream in, not just a declared
        # Content-Length, so it also catches a chunked request that omits
        # one. Keep this equal to SyncRequestSizeFilter.MAX_PUSH_REQUEST_BYTES
        # (server/src/main/java/lt/hereader/server/sync/SyncRequestSizeFilter.java)
        # — that file has the derivation.
        request_body {
            max_size 16MB
        }
        reverse_proxy app:8080 {
            # RateLimitFilter (server/src/main/java/lt/hereader/server/config/
            # RateLimitFilter.java) keys off request.getRemoteAddr(), which
            # Spring's forward-headers-strategy=framework resolves from
            # X-Forwarded-For. Caddy's default behaviour is to append the
            # connecting IP to whatever X-Forwarded-For a client already
            # sent, and Spring trusts the leftmost entry — so a client could
            # forge its own rate-limit identity by sending its own
            # X-Forwarded-For. Overwrite it instead with CF-Connecting-IP,
            # which Cloudflare sets from its own edge connection and strips
            # from the inbound request before doing so; trustworthy here
            # specifically because client_auth above has already confirmed
            # this request came from Cloudflare and not straight to the
            # origin IP.
            header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        }
    }

    handle {
        root * /srv/web

        # try_files {path} /index.html alone answers 200 for every missing
        # path, asset or route alike, because /index.html always exists as
        # the fallback candidate (issue #124). Gate the fallback to paths
        # that look like a client-side route: no file extension. A request
        # for a real but missing asset then reaches file_server unrewritten
        # and gets a genuine 404. Extensions below are what
        # `flutter build web` emits today, plus common static-asset types
        # this bundle doesn't currently use, so a future asset type missing
        # on deploy still 404s instead of silently returning the SPA shell.
        #
        # The extension check alone still misses assets/ (issue #165): the
        # bundle ships extensionless files there too (NOTICES is one), so a
        # missing one is indistinguishable from a client route by extension
        # alone. Nothing under assets/ is ever a client-side route, so
        # exclude it independently of the extension list.
        @spa {
            not path *.js *.mjs *.wasm *.map *.json *.png *.jpg *.jpeg *.svg *.ico *.css *.ttf *.otf *.woff *.woff2 *.bin *.symbols *.frag *.last_build_id *.html
            not path /assets/*
            file {
                try_files {path} /index.html
            }
        }
        rewrite @spa {file_match.relative}

        file_server
    }
}