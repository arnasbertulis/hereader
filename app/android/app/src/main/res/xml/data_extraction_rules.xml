<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" on the <application> element disables cloud
  backup, but on API 31+ device-to-device transfer is a separate channel with
  its own rules (see AndroidManifest.xml's android:dataExtractionRules) —
  with none declared, the platform default backs up everything except
  no-backup/cache directories. Excluding the whole private data root here
  mirrors what allowBackup="false" already does for cloud backup, so neither
  channel copies the reading database, covers, positions or stored profiles.
-->
<data-extraction-rules>
    <device-transfer>
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
